{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm ci --prefix ../web",
  "buildCommand": "npm run build:site",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/profile", "destination": "/api/profile.json" },
    { "source": "/api/projects", "destination": "/api/projects.json" },
    {
      "source": "/api/projects/:slug(tapwave|cookie-clicker|modrusa|pocmarano|agedate)",
      "destination": "/api/projects/:slug.json"
    },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
