{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API of the portfolio: content and the contact form",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "build:site": "npm --prefix ../web run build && node scripts/copy-web.mjs && nest build && node dist/prerender.js",
    "start": "node dist/main.js",
    "lint": "eslint",
    "test": "vitest run"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/serve-static": "^12.1.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.38.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
